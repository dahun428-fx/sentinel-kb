# cp terraform.tfvars.example terraform.tfvars
# 시크릿은 절대 여기 넣지 않는다 — SSM Parameter Store 로 수동 주입한다(infra/ssm.tf).
route53_zone_name = "example.com"
domain_name       = "kb.example.com"

