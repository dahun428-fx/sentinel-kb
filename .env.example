# --- 공통 ---
NODE_ENV=development
LOG_LEVEL=info

# --- MongoDB Atlas ---
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>/sentinel?retryWrites=true
MONGODB_DB=sentinel
# 서버 선택 타임아웃(ms). 기본 5000 — 오설정이 30초씩 매달리지 않게 짧게 둔다 (T-003).
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# --- LLM / Embedding ---
ANTHROPIC_API_KEY=
EMBEDDING_PROVIDER=voyage
EMBEDDING_MODEL=voyage-3
EMBEDDING_DIM=1024
EMBEDDING_VERSION=1
VOYAGE_API_KEY=

# --- Auth ---
# 프로젝트별 키: <key>:<projectSlug> 콤마 구분
API_KEYS=devkey123:sentinel-kb,devkey456:bizcare-web

# --- Retrieval tuning (specs/03) ---
RETRIEVAL_VECTOR_K=20
RETRIEVAL_TEXT_K=20
RETRIEVAL_FINAL_K=8
RRF_K=60
SIMILARITY_THRESHOLD=0.62

# --- Sanitize gate (specs/00 FR-06, T-004) ---
# 이메일 마스킹. 기본 off — 담당자 이메일은 대개 진단 정보다.
# `1|true|yes|on`(대소문자 무시)일 때만 켜진다.
SANITIZE_MASK_EMAIL=false

# --- Service ports ---
CORE_API_PORT=3001
MCP_PORT=3002
WEB_PORT=3000
