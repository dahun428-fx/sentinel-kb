# --- 공통 ---
NODE_ENV=development
LOG_LEVEL=info

# --- MongoDB Atlas ---
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>/sentinel?retryWrites=true
MONGODB_DB=sentinel
# 서버 선택 타임아웃(ms). 기본 5000 — 오설정이 30초씩 매달리지 않게 짧게 둔다 (T-003).
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# --- LLM / Embedding ---
# ⚠️ core-api는 이 둘이 없으면 **부팅하지 않는다** (T-039 D-4). `/v1/answer`가 조용히 사라지는
#    것보다 뜨지 않는 편이 낫다 — 라우트가 없으면 드리프트 가드는 초록인데 프로덕션엔 표면이
#    없는 상태가 되고, 그걸 아무도 관측하지 못한다 (T-019 F-8).
ANTHROPIC_API_KEY=
# 생성에 쓸 모델 ID. **코드에 기본값이 없다** — EMBEDDING_MODEL과 같은 규약이다.
# 코드에 박으면 세대 교체가 재배포가 되고, llm/no-hardcoded-model.spec.ts가 그걸 막는다.
ANTHROPIC_MODEL=claude-opus-5
# 모델 호출 1회의 벽시계 상한(ms). SDK 기본값은 10분인데 NFR-01(MCP 도구 p95 < 2s)의 300배다.
# 이 값은 MCP 클라이언트의 시도당 타임아웃(10초)보다 아래여야 한다 — 그보다 오래 걸린 생성은
# 아무도 받지 못하고 토큰만 태운다 (T-019 F-7). 양의 정수가 아니면 기본값(8000).
ANTHROPIC_TIMEOUT_MS=8000
# 재시도 횟수(총 시도 = 이 값 + 1). SDK 기본은 2(=3회)인데 MCP 클라이언트가 이미 자기 층에서
# 3회 시도하므로 층이 곱해져 요청 1건에 모델 호출 9회가 된다. 재시도는 **빠른 실패**
# (429 즉시 응답, 연결 거부)에만 의미가 있다 — 타임아웃 뒤의 재시도는 호출자가 이미 포기한
# 뒤라 과금만 두 배다. **0이 유효값**이다(재시도 안 함). 음이 아닌 정수가 아니면 기본값(1).
ANTHROPIC_MAX_RETRIES=1
# ⚠️ temperature/top_p/top_k에 해당하는 env는 **일부러 없다.** 현행 Claude 모델이 그것을
#    400으로 거절한다 (T-018 D-3). 아래 Generation tuning 절의 같은 주석과 한 쌍이다.
# `fake`는 테스트 전용이다. fake 벡터는 서로 다른 텍스트 간 cosine이 0 근처라
# SIMILARITY_THRESHOLD 게이트가 모든 질의에 found:false를 낸다 (T-006 F-8, 시드 INC-18).
# 그래서 `pnpm db:seed`는 fake일 때 --allow-fake-embeddings 없이는 적재를 거부한다 (T-009).
# 통합 테스트는 fake를 쓴다 — 거기서 검증하는 것은 청크 생성·멱등성이지 유사도 값이 아니다.
EMBEDDING_PROVIDER=voyage
EMBEDDING_MODEL=voyage-3
EMBEDDING_DIM=1024
EMBEDDING_VERSION=1
VOYAGE_API_KEY=
# 임베딩 1회 HTTP 호출에 담는 텍스트 수. specs/03 §1-3의 하드 상한 32를 넘길 수 없다(초과분은 32로 클램프).
EMBEDDING_BATCH_SIZE=32

# --- Auth ---
# 프로젝트별 키: <key>:<projectSlug> 콤마 구분
# ⚠️ **MCP 컨테이너와 core-api 컨테이너가 반드시 같은 값을 받아야 한다** (T-014 D-5,
#    docs/connect.md §2). MCP는 자기 키를 들고 있지 않고 호출자 Bearer를 그대로 core-api로
#    넘긴다(confused deputy 방지). 값이 갈라지면 **MCP 연결도 도구 목록도 정상인데
#    도구를 호출하는 순간에만** core-api가 401을 낸다 — 실패가 한참 뒤에 드러난다.
#    두 프로세스는 서로의 env를 모르므로 **코드로는 탐지할 수 없다.** compose의
#    `x-shared-auth` 앵커 하나를 두 서비스가 참조하는 것이 유일한 방어선이고,
#    `tools/compose-contract.int.spec.ts`가 해소된 값을 대조한다.
API_KEYS=devkey123:sentinel-kb,devkey456:bizcare-web

# --- MCP 서버 (T-014, T-017 / docs/connect.md §5) ---
# core-api 주소. compose 네트워크 안에서는 서비스 이름이 DNS 이름이라 `http://core-api:3001`이다.
# 미설정이면 코드가 http://localhost:3001로 되돌린다.
# **웹(Next.js)도 같은 변수를 읽는다** — 둘 다 core-api를 소비하고 주소가 갈라질 이유가 없다.
CORE_API_URL=http://localhost:3001
# core-api 호출 1회의 타임아웃(ms). 기본 10000.
CORE_API_TIMEOUT_MS=10000
# 총 시도 횟수. **읽기 경로에만 적용된다** — `record_knowledge` 같은 쓰기는 절대 재시도하지
# 않는다. 타임아웃은 "도달하지 않았다"가 아니라 "결과를 모른다"이고, 재전송하면 레코드가
# 두 벌 생긴다. 기본 3.
CORE_API_MAX_ATTEMPTS=3
# **stdio 모드 전용.** 이 프로세스가 쓸 project 키이며 `API_KEYS`의 <key> 부분과 정확히
# 일치해야 한다. HTTP 모드에서는 요청 헤더로 오므로 쓰이지 않는다.
# 확정하지 못하면 stdio 서버는 **부팅에서 죽는다**(docs/connect.md §4-2).
SENTINEL_KB_KEY=devkey123

# --- Web UI (T-023) ---
# 웹 서버 컴포넌트가 core-api를 부를 때 실을 Bearer 키. 없으면 웹이 부팅에서 죽는다(NFR-04).
# ⚠️ `NEXT_PUBLIC_` 접두사를 붙이지 마라 — 브라우저 번들에 실린다
#    (`packages/web/src/client-safety.spec.ts`가 그걸 막는다).
# 주소는 위 CORE_API_URL을 공유한다.
CORE_API_KEY=devkey123

# --- Chunking tuning (specs/03 §1-2) ---
# 청크 1개의 최대 문자 수. prefix "[title] (section) "를 포함한 총량이며,
# 초과하면 문단 → 문장/줄 경계로 분할한다 (T-005).
CHUNK_MAX_CHARS=1200

# --- Embedding worker tuning (specs/03 §1-4, T-008) ---
# 임베딩 잡 재시도 상한. 실패 시 attempts++ 하고 이 값에 도달하면 dead로 보낸다.
# specs/03 §1-4의 "3회"를 코드 상수로 굳히면 §6(파라미터 env화) 위반이라 여기로 뺐다.
EMBED_JOB_MAX_ATTEMPTS=3
# pending 잡이 없을 때 다음 폴링까지의 대기(ms).
EMBED_POLL_INTERVAL_MS=1000

# --- Atlas 검색 인덱스 부트스트랩 (specs/02 §인덱스, T-010) ---
# `pnpm db:search-indexes`가 vec_idx/text_idx를 만든 뒤 READY가 될 때까지 기다리는 상한(ms).
# 생성 직후 상태는 PENDING이고 그때 쿼리하면 "Index vec_idx not initialized"로 죽는다.
# 로컬 atlas-local은 1초대, 실 Atlas의 대량 컬렉션은 분 단위다. 양수가 아니면 기본값(300000).
SEARCH_INDEX_READY_TIMEOUT_MS=300000
# 상태 폴링 간격(ms). 양수가 아니면 기본값(2000).
SEARCH_INDEX_POLL_INTERVAL_MS=2000

# --- Retrieval tuning (specs/03 §2·§6, T-011) ---
# 양의 정수가 아니면(미설정 포함) 코드가 이 파일과 같은 기본값으로 되돌린다.
# 융합에 넘길 후보 수. 두 경로 각각에 적용된다.
RETRIEVAL_VECTOR_K=20
RETRIEVAL_TEXT_K=20
# dedupeByRecordId 이후 최종 반환 수.
RETRIEVAL_FINAL_K=8
# RRF 감쇠 상수. score = Σ 1/(k + rank).
# 이 점수는 **순위 결정 전용**이며 SIMILARITY_THRESHOLD(cosine)와 비교할 수 없다 (감사 B-1).
RRF_K=60
# $vectorSearch의 ANN 탐색 폭. RETRIEVAL_VECTOR_K * RETRIEVAL_CANDIDATE_OVERFETCH보다
# 작으면 Atlas가 쿼리를 거부하므로 코드가 그 값으로 끌어올린다.
RETRIEVAL_NUM_CANDIDATES=200
# 후보를 K의 몇 배로 긁어올지. T-005 F-3 대응 — 레코드 1건이 청크 28개까지 가므로
# 여유분 없이 K만 긁으면 장문 레코드 하나가 후보 슬롯을 통째로 먹고,
# dedupe 후 최종 결과에 레코드가 사실상 1건만 남는다.
RETRIEVAL_CANDIDATE_OVERFETCH=4
# record당 최대 청크 수. specs/03 §2의 "record당 최대 2청크"다.
# 후보 단계 상한과 융합 후 dedupe에 **같은 값**이 쓰인다 — 그래야 후보 단계에서 버리는 청크가
# 어차피 dedupe가 버렸을 것들뿐이라 재현율 손실이 없다.
RETRIEVAL_MAX_CHUNKS_PER_RECORD=2

# --- 관계 확장 (specs/03 §2.5, ADR-07 단계 0, T-035) ---
# 융합 상위 진입점 레코드의 relations 1홉을 $graphLookup으로 순회해
# recurrence_of·same_root_cause 대상의 resolution/prevention 청크를 **최대 3개** 병합한다.
# on|off (true/false/1/0/yes/no도 받는다). 인식하지 못하는 값은 off로 되돌린다.
#
# ⚠️ **기본이 off인 것은 실수가 아니다.** specs/03 §2.5와 ADR-07 §5가
#    "eval에서 효과를 비교한다 — 지표가 오르지 않으면 확장하지 않는다"로 못박았고,
#    그 측정은 아직 되지 않았다(T-013 STATUS: BLOCKED — 임베딩 자격증명 부재).
#    켜려면 eval/retrieval/README.md의 on/off 비교 절차를 먼저 돌리고 리포트를 근거로 붙여라.
RELATION_EXPANSION=off
# 생성 게이트 임계값(**원시 cosine**, 범위 -1..1). 판정은 T-018이 하며, retriever는
# 비교 대상이 되는 **융합 전 원시 cosine 최고점**(RetrievalResult.maxVectorScore)만 돌려준다.
# ⚠️ Atlas의 $vectorSearch가 주는 vectorSearchScore는 원시 cosine이 아니라 (1+cos)/2로
#    정규화된 0-1 값이다(실측: 동일 1.0 / 직교 0.5 / 정반대 0.0). retriever의 toRawCosine이
#    cos = 2*s - 1로 환산해서 돌려주므로, 이 임계값은 정규화 값이 아니라 원시 cosine과 비교된다.
#    환산이 없다면 0.62는 원시 cosine 0.24 게이트가 되어 의도보다 훨씬 헐거워진다.
#    유한수이고 -1..1 범위 안일 때만 쓰인다. 그 밖이면 기본값으로 되돌린다 — 범위 밖 임계값은
#    게이트를 항상-통과/항상-차단으로 만들어 튜닝이 아니라 무력화다 (T-018).
SIMILARITY_THRESHOLD=0.62

# --- Generation tuning (specs/03 §4·§6, T-018) ---
# 답변 1건의 출력 토큰 상한. 길이는 품질 파라미터라 eval(T-020)이 흔들 수 있어야 한다.
# 양의 정수가 아니면 기본값(2048).
ANSWER_MAX_TOKENS=2048
# ⚠️ temperature류 샘플링 파라미터는 **일부러 없다.** 현행 Claude 모델(Opus 5·Sonnet 5·4.7+)은
#    temperature/top_p/top_k를 받지 않고 400으로 거절한다. 생성의 결정론은 온도가 아니라
#    테스트의 fake 주입으로 얻는다 (specs/05 결정론 원칙).

# --- Publishing / 작문 파이프라인 (specs/08 §0·§4, T-031) ---
# 아티클 초안 1건의 출력 상한. 아티클은 답변보다 길어 ANSWER_MAX_TOKENS보다 크다.
DRAFT_MAX_TOKENS=4096
# 스타일 few-shot 표본 1편의 문자 수 상한. 표본이 길면 팩트 팩이 프롬프트 뒤로 밀린다.
STYLE_SAMPLE_MAX_CHARS=6000
# 서사 재료로 실리는 레코드 본문 한 섹션의 문자 수 상한(문장 경계에서 잘린다).
NARRATIVE_PART_MAX_CHARS=600
# 문체 few-shot 디렉터리. 미설정이면 레포 루트의 prompts/style/.
STYLE_SAMPLES_DIR=
# ⚠️ 재작성 상한(2회)은 **일부러 env에 없다.** specs/08 §4의 문면이지 튜닝 값이 아니며,
#    0으로 끄면 문체 린터가 무력해지고 크게 올리면 야간 배치 비용이 샌다
#    (generator의 재생성 1회를 env 밖에 둔 것과 같은 규약).

# --- Sanitize gate (specs/00 FR-06, T-004) ---
# 이메일 마스킹. 기본 off — 담당자 이메일은 대개 진단 정보다.
# `1|true|yes|on`(대소문자 무시)일 때만 켜진다.
SANITIZE_MASK_EMAIL=false
# 새니타이즈 입력 길이 상한(문자 수). 기본 65536.
# 저장 경로의 동기 게이트라 초과 입력은 자르지 않고 SANITIZE_INPUT_TOO_LARGE로 거절한다 —
# 조용히 자르면 잘린 부분의 시크릿을 검사하지 않은 채 호출자가 저장한다 (T-004).
# 양의 정수가 아니면 기본값으로 되돌린다(오설정이 게이트를 무력화하지 않게).
SANITIZE_MAX_INPUT_CHARS=65536

# --- Retrieval eval (specs/05 Eval 1, T-013) ---
# `pnpm eval:retrieval`이 골든셋 질의를 보낼 core-api 주소.
# 미설정이면 http://localhost:${CORE_API_PORT:-3001}로 되돌린다.
# ⚠️ eval은 EMBEDDING_PROVIDER=fake면 아무것도 재지 않고 EX_CONFIG(78)로 거절한다 —
#    해시 벡터는 cosine이 0 근처라 Recall@5가 BM25 단독 성능을 재게 된다 (T-006 F-8).
EVAL_CORE_API_URL=

# --- Generation eval (specs/05 Eval 2, T-020) ---
# LLM-as-judge가 쓸 모델. specs/05가 "소형 모델 사용"을 요구하므로 답변 생성 모델과
# 같을 이유가 없다. 미설정이면 ANTHROPIC_MODEL을 쓴다.
# ⚠️ 모델·키가 둘 다 없으면 `pnpm eval:generation`은 아무것도 재지 않고 EX_CONFIG(78)로
#    거절한다. 측정 없이 쓴 judge 점수는 기준선이 될 수 없다.
EVAL_JUDGE_MODEL=

# --- Service ports ---
CORE_API_PORT=3001
MCP_PORT=3002
WEB_PORT=3000

# 재시도 백오프 기준(ms). n번째 실패 후 base * 2^(n-1) 만큼 지나야 다시 클레임된다.
# 이게 없으면 10초짜리 순단이 밀리초 안에 attempts를 태워 dead로 보낸다 (T-008).
EMBED_RETRY_BACKOFF_MS=2000

# ===========================================================================
# 아래는 **compose/배포 전용**이다 (T-026, specs/06). 애플리케이션 코드는 읽지 않는다.
# 프로덕션에서는 이 파일이 손으로 만들어지지 않는다 — SSM Parameter Store(SecureString)에서
# 배포 시 `.env`로 렌더된다(specs/06 시크릿 행). **어떤 값도 여기에 리터럴로 적지 않는다.**
# ===========================================================================

# --- 로컬 compose (docker-compose.yml) ---
# nginx가 호스트에 붙일 포트. 로컬에서 `http://localhost:8080/health`가 200이면 스택이 산 것이다.
NGINX_HTTP_PORT=8080

# --- 프로덕션 오버레이 (docker-compose.prod.yml) ---
# 배포할 이미지 좌표. T-027(CI/CD)이 채운다.
ECR_REGISTRY=
IMAGE_TAG=
AWS_REGION=ap-northeast-2
# infra/ec2.tf가 만드는 CloudWatch 로그 그룹 이름(`/{project}/{env}/app`).
LOG_GROUP_NAME=/sentinel-kb/prod/app
# nginx server_name·TLS 인증서 경로에 쓰인다. infra/route53.tf의 A 레코드와 같아야 한다.
DOMAIN_NAME=
# --- certbot (DNS-01) ---
# ⚠️ 챌린지는 **DNS-01**이다. specs/06이 "SG 443만"과 "certbot"을 동시에 요구하는데
#    HTTP-01은 80번 인바운드를 요구해 양립하지 않는다(T-025 F-3). Route53이 이미 있어
#    DNS-01이면 인바운드를 하나도 열지 않고 발급된다. 근거는 docker/README.md.
CERTBOT_EMAIL=
# Route53 전파 대기(초). 짧으면 검증이 전파 전에 실행돼 간헐 실패한다.
CERTBOT_DNS_PROPAGATION_SECONDS=30

# --- 부하 스크립트 (`pnpm loadtest`, T-026 / NFR-01) ---
# 측정 대상 core-api 주소. 미설정이면 EVAL_CORE_API_URL → http://localhost:3001 순으로 되돌린다.
LOADTEST_URL=
