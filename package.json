{
  "name": "sentinel-kb",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:integration",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -b",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration --passWithNoTests",
    "build": "tsc -b",
    "dev": "pnpm -r --parallel dev",
    "db:indexes": "tsx packages/core/src/db/ensure-indexes.cli.ts",
    "db:seed": "tsx scripts/seed.cli.ts",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@sentinel/api": "workspace:*",
    "@sentinel/contracts": "workspace:*",
    "@sentinel/core": "workspace:*",
    "@sentinel/worker": "workspace:*",
    "@types/node": "^22.10.0",
    "eslint": "^9.30.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-import-resolver-typescript": "^4.4.0",
    "eslint-plugin-import": "^2.32.0",
    "mongodb": "^6.12.0",
    "mongodb-memory-server": "^10.1.4",
    "prettier": "^3.6.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.40.0",
    "vitest": "^3.2.4"
  }
}
